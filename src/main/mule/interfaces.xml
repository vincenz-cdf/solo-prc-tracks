	<flow name="get:\heartbeat:Router" doc:id="1dc42250-85dc-49b7-bedd-2f18bca09b5a" >
		<logger level="INFO" doc:name="Start heartbeat flow" doc:id="e8fad0ad-9c74-4b66-8856-3dcd8de700ed" message='#[import prettifyFlowName from modules::ToolBox&#10;---&#10;{&#10;	step:"Start $(prettifyFlowName(flow.name)) flow",&#10;	data: {}&#10;}]' category="${app.name}" />
		<ee:transform doc:name="Transform Message" doc:id="ff9324a5-fce2-49a6-a4f4-0552a7563506" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  status: "Healthy",
  name: "solo-prc-tracks",
  version: "1.0.1",
  "type": "Unknown"
} as Object {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="End heartbeat flow" doc:id="3ad5a638-a540-49bb-8dfa-980f86231b1e" message='#[import prettifyFlowName from modules::ToolBox&#10;---&#10;{&#10;	step:"Start $(prettifyFlowName(flow.name)) flow",&#10;	data: {}&#10;}]' category="solo-prc-tracks" />
	</flow>
