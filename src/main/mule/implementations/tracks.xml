<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<sub-flow name="postEvents" doc:id="7f0d7e39-a0a9-4e37-9cd2-7db15def0d2d" >
		<ee:transform doc:name="Extract reccurnt genres" doc:id="ace7c0e3-2a3c-432c-9931-06c6f2e18f2c" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
var allGenres = readUrl("classpath://lastfm/tags.json" , "application/json")

// On recup un tableau avec uniquement tout les tags
var allGenresArray = flatten(vars.csvFileContent map () -> $.genres splitBy(",") map (item) -> trim(item))

// On s'assure que les tags existent
var filteredGenres = allGenresArray filter (genre) -> (allGenres.tags contains genre)

// On compte le nb occurences par genres
var countedGenres = (filteredGenres groupBy ((genre) -> genre)) mapObject ((value, key) -> {
  (key): sizeOf(value)
})
---
//allGenresArray

// filteredGenres

(countedGenres orderBy ((genre) -> -(genre)) pluck ((value, key) -> key))[0 to 1]
]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<set-variable value="#[payload]" doc:name="[genres]" doc:id="e011b110-c74a-4b43-8fe2-445fa6bb5cfd" variableName="genres"/>
		<logger level="DEBUG" doc:name="[DEBUG] genres" doc:id="1c4bcc1f-5473-4414-95b3-ff392355ff2c" message='#[{&#10;	step:"after genres extraction",&#10;	data: vars.genres&#10;}]' category="solo-prc-tracks"/>
		<http:request method="GET" doc:name="to LastFM" doc:id="373f3a23-13f8-4529-97e1-cb36c7d17fab" config-ref="LastfmRequestConfig" path="/tracks">
			<http:query-params><![CDATA[#[output application/java
---
{
	genres: vars.genres joinBy ","
}]]]></http:query-params>
		</http:request>
		<ee:transform doc:name="Datamapping en EDM" doc:id="efecd42a-033a-4ae3-8f99-35c0fc31b8bd" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json

---
{
  "sendDate": vars.sendDate,
  "eventDate": vars.eventDate,
  "genres": vars.genres,
  "users": vars.csvFileContent map () -> {
    firstname: $.firstname,
    lastname: $.lastname,
    email: $.email,
    genres: $.genres splitBy(",") map (genre) -> trim(genre),
  },
  "tracks": payload
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<http:request method="POST" doc:name="to SFTP" doc:id="a60b154a-b742-4388-b0bd-89cb71ddbe0c" config-ref="SFTPRequestConfig" path="/events" >
			<error-mapping sourceType="HTTP:NOT_ACCEPTABLE" targetType="MUSIK:INVALID_FILE" />
		</http:request>
	</sub-flow>
	<sub-flow name="sendEmails" doc:id="c308231e-1f31-4b03-b4ef-f7b8a05d46f8" >
		<logger level="INFO" doc:name="Logger" doc:id="304998ea-a87b-4481-8a6d-eb9a930f248e" />
		<http:request method="GET" doc:name="to SFTP (GET CSV)" doc:id="c329ea8a-11ac-4a45-b795-996578cf739e" config-ref="SFTPRequestConfig" path='#["/events/" ++ vars.today as String]'>
			<error-mapping sourceType="HTTP:NOT_FOUND" targetType="MUSIK:FILE_NOT_FOUND" />
			<http:query-params ><![CDATA[#[output application/java
---
{
	"fileType" : "csv"
}]]]></http:query-params>
		</http:request>
		<set-variable value='#[payload]' doc:name="[csvFile]" doc:id="31c9c862-58fa-4a7a-8dba-da977780edf2" variableName="csvFile"/>
		<http:request method="GET" doc:name="to SFTP (GET JSON)" doc:id="e34d30c6-8966-48b6-8674-7e366ac0f000" config-ref="SFTPRequestConfig" path='#["/events/" ++ vars.today as String]' >
			<error-mapping sourceType="HTTP:NOT_FOUND" targetType="MUSIK:FILE_NOT_FOUND" />
			<http:query-params ><![CDATA[#[output application/java
---
{
	"fileType" : "json"
}]]]></http:query-params>
		</http:request>
		<logger level="DEBUG" doc:name="[DEBUG] JSON GET" doc:id="966d0a87-686c-4463-801d-ac6b7b3ba1cc" message='#[{&#10;	step:"SFTP RETRIEVE JSON",&#10;	data: payload&#10;}]' category="solo-prc-tracks" />
		<ee:transform doc:name="Datamapping to EDM" doc:id="7b77813d-a34a-4598-9df7-157f721b4496">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json

---
{
  "sendDate": vars.today,
  "eventDate": payload.eventDate, 
  "genres": payload.genres,
  "users": read(vars.csvFile, "application/csv") map () -> {
    firstname: $.firstname,
    lastname: $.lastname,
    email: $.email,
    genres: $.genres splitBy(",") map (genre) -> trim(genre),
  },
  "tracks": payload.tracks
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<http:request method="POST" doc:name="to Sendgrid" doc:id="9a1fecee-5a3a-4e79-a21c-39da654156c7" config-ref="SMTPRequestConfig" path="/events" />
	</sub-flow>
</mule>
